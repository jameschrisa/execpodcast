{
  "name": "Executive Upskill",
  "site": "https://executiveupskill.live",
  "positioning": {
    "what": "A live video podcast. Three operators argue one AI decision at a time from the brand, finance and venture seats.",
    "audience": "Executives and operators deciding about AI: marketing and brand leaders, finance leaders, founders and investors.",
    "campaignLine": "One question. Three lenses.",
    "heroLine": "Three operators talk AI, business and brand from the seats they've held. Live on YouTube, clipped for your feed.",
    "premiere": {
      "date": "2026-11-18T11:00:00-08:00",
      "display": "Wed Nov 18, 11:00 PT",
      "platform": "YouTube Live",
      "minutes": 90,
      "episode": "Your 2027 AI Budget, Argued Three Ways"
    },
    "lenses": [
      {
        "id": "brand",
        "host": "James Christopher",
        "role": "Host and moderator",
        "label": "Brand lens",
        "headline": "Brand meets the bot",
        "asksFirst": "Who's the human in this loop, and can they say no?"
      },
      {
        "id": "money",
        "host": "Greg Fisher",
        "role": "Co-host",
        "label": "AI and finance lens",
        "headline": "Make the AI pay",
        "asksFirst": "Which line on the P&L moves, and when?"
      },
      {
        "id": "venture",
        "host": "Bryce Gilleland",
        "role": "Co-host",
        "label": "Venture lens",
        "headline": "Bet before consensus",
        "asksFirst": "If this works, who keeps the money?"
      }
    ],
    "channels": {
      "youtube": "@ExecutiveUpskill",
      "shorts": "@ExecutiveUpskill",
      "instagram": "@exec.upskill",
      "tiktok": "@execupskill",
      "linkedin": "Executive Upskill"
    }
  },
