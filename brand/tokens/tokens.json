{
  "color": {
    "light": {
      "paper": "#f7f7f5",
      "paper-raised": "#ffffff",
      "ink": "#121212",
      "ink-soft": "#2a2a28",
      "muted": "#5a5a57",
      "line": "#e2e2dd",
      "accent": "#ff4d12",
      "accent-ink": "#b93408",
      "on-accent": "#121212",
      "scrim": "#121212"
    },
    "dark": {
      "paper": "#0e0e0d",
      "paper-raised": "#171716",
      "ink": "#f2f2ee",
      "ink-soft": "#d6d6d1",
      "muted": "#a3a39f",
      "line": "#2a2a28",
      "accent": "#ff5a1f",
      "accent-ink": "#ff6a33",
      "on-accent": "#0e0e0d",
      "scrim": "#0b0b0a"
    },
    "logo": {
      "black": "#0e0e0e",
      "white": "#f2f2ee",
      "orange": "#ff4d12"
    }
  },
  "lens": {
    "light": {
      "brand": "#ff4d12",
      "brand-ring": "#e03c05",
      "brand-text": "#121212",
      "money": "#d9dad5",
      "money-ring": "#bdbfb8",
      "money-text": "#121212",
      "venture": "#151515",
      "venture-ring": "#343432",
      "venture-text": "#f2f2ee"
    },
    "dark": {
      "brand": "#ff5a1f",
      "brand-ring": "#ff7a47",
      "brand-text": "#0e0e0d",
      "money": "#262724",
      "money-ring": "#3a3b37",
      "money-text": "#f2f2ee",
      "venture": "#f2f2ee",
      "venture-ring": "#d6d6d1",
      "venture-text": "#121212"
    }
  },
  "font": {
    "display": {
      "family": "Archivo",
      "stack": "\"Archivo\", \"Arial Narrow\", sans-serif",
      "source": "Google Fonts, variable, wdth axis",
      "fontVariationSettings": "\"wdth\" 62",
      "weight": 900,
      "letterSpacing": "-0.01em",
      "wordSpacing": "0.06em",
      "lineHeight": 0.88,
      "textTransform": "uppercase"
    },
    "body": {
      "family": "Geist",
      "stack": "\"Geist\", ui-sans-serif, system-ui, sans-serif",
      "source": "Google Fonts"
    },
    "logoFallback": {
      "family": "Anton",
      "file": "src/assets/Anton-Regular.ttf",
      "use": "favicon monogram, share images, home-screen icon"
    }
  },
  "radius": {
    "card": "16px",
    "panel": "16px",
    "input": "12px",
    "pill": "9999px",
    "focus": "6px"
  },
  "shadow": {
    "light": "0 1px 0 rgb(18 18 18 / 0.04), 0 18px 40px -24px rgb(18 18 18 / 0.25)",
    "dark": "0 1px 0 rgb(0 0 0 / 0.3), 0 18px 40px -24px rgb(0 0 0 / 0.7)",
    "panelRing": "inset 0 0 0 6px var(--panel), inset 0 0 0 8px var(--panel-ring)"
  },
  "motion": {
    "easeOutExpo": "cubic-bezier(0.16, 1, 0.3, 1)",
    "wordmarkRise": {
      "duration": "0.9s",
      "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
      "staggerPerLetter": "28ms"
    },
    "marquee": "38s linear infinite",
    "detailsHeight": "0.35s var(--ease-out-expo)",
    "button": "200ms ease-out, active scale 0.98",
    "reducedMotion": "all animation off under prefers-reduced-motion: reduce"
  },
  "grain": {
    "opacityLight": 0.05,
    "opacityDark": 0.07,
    "svg": "feTurbulence fractalNoise baseFrequency 0.9, 2 octaves, 160px tile",
    "zIndex": 60
  },
  "focus": {
    "outline": "2px solid var(--accent)",
    "offset": "3px"
  }
}