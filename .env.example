# Copy to .env.local for local work, and set the same keys in your host (Vercel, etc.).

# PostHog project API key (starts with phc_). Project settings > Project API key.
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog cloud region: "us" (us.posthog.com) or "eu" (eu.posthog.com).
NEXT_PUBLIC_POSTHOG_REGION=us

# Public site URL, used for canonical links, sitemap and share images.
NEXT_PUBLIC_SITE_URL=https://executiveupskill.live

# Premiere start, ISO 8601 with offset. Drives every countdown and calendar file.
NEXT_PUBLIC_PREMIERE_AT=2026-10-28T11:00:00-07:00

# The scheduled YouTube Live event URL. Once set, "Subscribe on YouTube" buttons
# become "Set YouTube reminder" and point here.
NEXT_PUBLIC_YT_LIVE_URL=

# Optional. Every form submission is POSTed here as JSON (Zapier, Make, Slack
# workflow, HubSpot, Google Apps Script). Leave blank to rely on PostHog only.
LEADS_WEBHOOK_URL=
